[Unit]
Description=Agent Share Box Docker file sharing service
Documentation=https://github.com/Sunwood-ai-labs/agent-share-box
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/srv/agent-share-box

[Service]
Type=simple
EnvironmentFile=/etc/agent-share-box/agent-share-box.env
ExecStartPre=-/usr/bin/docker rm -f agent-share-box
ExecStart=/opt/agent-share-box/run-container.sh
ExecStop=/usr/bin/docker stop agent-share-box
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
