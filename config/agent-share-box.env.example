AGENT_SHARE_PORT=3923
AGENT_SHARE_USERNAME=agent
AGENT_SHARE_PASSWORD=
AGENT_SHARE_AUTH=0
AGENT_SHARE_DATA_DIR=/srv/agent-share-box
AGENT_SHARE_STATE_DIR=/var/lib/agent-share-box
AGENT_SHARE_TITLE=Agent Share Box

